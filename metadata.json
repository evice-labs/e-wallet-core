{
  "name": "e_wallet_core",
  "display_name": "e-wallet-core",
  "version": "0.1.0",
  "type": "core",
  "interface": "universal",
  "category": "wallet",
  "description": "Logos Basecamp core module wrapping LEZ Wallet SDK",
  "main": "e_wallet_core_plugin",
  "codegen": {
    "impl_header": "src/e_wallet_core_impl.h",
    "impl_class": "EWalletCoreImpl"
  },
  "dependencies": [],
  "nix": {
    "packages": {
      "build": [
        "nlohmann_json",
        "pcsclite"
      ],
      "runtime": [
        "nlohmann_json",
        "pcsclite"
      ]
    },
    "external_libraries": [
      {
        "name": "lez_wallet_sdk",
        "vendor_path": "lib"
      }
    ],
    "cmake": {
      "find_packages": [
        "nlohmann_json"
      ],
      "extra_sources": [],
      "extra_include_dirs": [
        "lib"
      ],
      "extra_link_libraries": []
    }
  }
}
