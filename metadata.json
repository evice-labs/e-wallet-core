{
  "name": "e_wallet_core",
  "display_name": "Wallez Module",
  "version": "0.2.2",
  "type": "core",
  "interface": "universal",
  "category": "wallet",
  "description": "Wallez module wrapping Evice Wallet SDK.",
  "main": "e_wallet_core_plugin",
  "codegen": {
    "impl_header": "src/e_wallet_core_impl.h",
    "impl_class": "EWalletCoreImpl"
  },
  "dependencies": [],
  "include": [],
  "platforms": [
    {
      "when": { "os": "linux" },
      "include": ["libpcsclite.so.1", "libpcsclite.so"]
    }
  ],
  "nix": {
    "packages": {
      "build": ["nlohmann_json"],
      "runtime": ["nlohmann_json"]
    },
    "external_libraries": [
      {
        "name": "e_wallet_sdk",
        "vendor_path": "lib"
      }
    ],
    "cmake": {
      "find_packages": ["nlohmann_json"],
      "extra_sources": [],
      "extra_include_dirs": ["lib"],
      "extra_link_libraries": []
    },
    "platforms": [
      {
        "when": { "os": "linux" },
        "packages": {
          "build": ["pcsclite"],
          "runtime": ["pcsclite.lib"]
        },
        "cmake": {
          "extra_link_libraries": ["pcsclite"]
        }
      },
      {
        "when": { "os": "darwin" },
        "packages": {
          "build": ["pcsclite"],
          "runtime": ["pcsclite.lib"]
        },
        "cmake": {
          "extra_link_libraries": ["pcsclite"]
        }
      },
      {
        "when": { "os": "windows" },
        "cmake": {
          "extra_link_libraries": ["winscard"]
        }
      }
    ]
  }
}
